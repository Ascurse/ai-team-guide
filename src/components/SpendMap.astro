---
import { dataNote } from '../data/freshness.js';
import { MAX_SCALE, PRICES, fmtK, money, spendAt } from '../lib/sim.js';
import { STRINGS } from '../scripts/strings.js';

const { lang } = Astro.props;
const T = {
  ru: {
    aria: 'Карта расхода токенов',
    title: 'Карта расхода: на что уходят токены',
    lead: 'Слева сессия как есть, справа с выбранными приёмами. Включите приём и посмотрите, какой слой усыхает. Сцену можно вращать.',
    note: 'Учебная модель на цене Terra, источники разные и складывать их точно нельзя, важна форма. ~84% токенов сессии агента на выводы инструментов (один источник). −87% на обработке вне контекста (самоотчёт context-mode). Скрытие старых выводов вдвое дешевле (один источник). Четверть схем взята для примера, у каждого своё лишнее.',
    stageAria: 'Две башни контекста: как есть и с приёмами',
    tools: 'Убрать лишние схемы',
    masked: 'Скрывать старые выводы',
    sandbox: 'Обрабатывать вне контекста',
    schemas: 'Схемы инструментов',
    outputs: 'Выводы инструментов',
    instructions: 'Инструкции',
    dialog: 'Диалог',
    context: 'Контекст',
    session: 'Вся сессия',
    saved: 'Экономия',
    turn: 'Ход',
    of50: 'из 50',
  },
  en: {
    aria: 'Token spending map',
    title: 'Spending map: where the tokens go',
    lead: 'On the left is the session as is, on the right with the chosen techniques. Turn on a technique and see which layer shrinks. You can rotate the scene.',
    note: 'A teaching model at Terra prices. The sources differ and cannot be added up precisely; the shape is what matters. About 84% of an agent session’s tokens go to tool outputs (one source). −87% from processing outside the context (self-reported by context-mode). Hiding old outputs is half the price (one source). A quarter of the schemas is just an example; everyone has different extras.',
    stageAria: 'Two context towers: as is and with techniques',
    tools: 'Remove extra schemas',
    masked: 'Hide old outputs',
    sandbox: 'Process outside the context',
    schemas: 'Tool schemas',
    outputs: 'Tool outputs',
    instructions: 'Instructions',
    dialog: 'Conversation',
    context: 'Context',
    session: 'The whole session',
    saved: 'Saved',
    turn: 'Turn',
    of50: 'of 50',
  },
}[lang];

const START_TURN = 30;
const base = spendAt(START_TURN, PRICES['GPT-6.1 Terra']);
const flat = (layers) => layers.map((l) => ({ kind: l.kind, width: `${(l.size / MAX_SCALE) * 100}%` }));
---
<section class="fig" id="fig-spend" aria-label={T.aria}>
<h3>{T.title}</h3>
<p class="lead">{T.lead}</p>
<div class="js-only">
<div class="row">
<label for="m-turn" style="flex:1 1 220px">{T.turn} <strong id="m-n">{START_TURN}</strong> {T.of50}
<input id="m-turn" type="range" min="1" max="50" value={START_TURN}></label>
</div>
<div class="row">
<button class="btn" id="m-tools" type="button" aria-pressed="false">{T.tools}</button>
<button class="btn" id="m-masked" type="button" aria-pressed="false">{T.masked}</button>
<button class="btn" id="m-sandbox" type="button" aria-pressed="false">{T.sandbox}</button>
</div>
</div>
<div class="stage" id="m-stage" role="img" aria-label={T.stageAria} hidden>
<div class="key" aria-hidden="true">
<div><b class="k-sys"></b>{T.instructions}</div>
<div><b class="k-tools"></b>{T.schemas}</div>
<div><b class="k-out"></b>{T.outputs}</div>
<div><b class="k-hist"></b>{T.dialog}</div>
</div>
</div>
<div class="flat" id="m-flat">
{[[STRINGS[lang].spend.asIs, 'm-flat-base'], [STRINGS[lang].spend.withTricks, 'm-flat-now']].map(([name, id]) => (
<div class="flat-row"><span>{name}</span><div class="stack" id={id}>{flat(base.layers).map((l) => <i class={`k-${l.kind}`} style={`width:${l.width}`}></i>)}</div></div>
))}
</div>
<div class="stats">
<div class="stat"><div>{T.context}</div><strong id="m-ctx">{fmtK(base.ctx)}</strong></div>
<div class="stat"><div>{T.session}</div><strong id="m-total">{money(base.total)}</strong></div>
<div class="stat"><div>{T.saved}</div><strong id="m-saved">0%</strong></div>
</div>
<div class="msg" id="m-msg" aria-live="polite">{STRINGS[lang].spend.none}</div>
<p class="note">{T.note}</p>
<p class="data-note">{dataNote(lang)}</p>
</section>
