---
import * as ruBrief from '../data/brief.js';
import * as enBrief from '../data/en/brief.js';

const { lang } = Astro.props;
const { BRIEF_BASE, BRIEF_PARTS, BRIEF_RESULTS, briefFile } = lang === 'en' ? enBrief : ruBrief;
const T = {
  ru: {
    aria: 'Как постановка меняет результат',
    title: 'Соберите постановку сами',
    lead1: 'Представьте: офис переезжает, вы пишете сотрудникам письмо и хотите поставить в него картинку. Обычно просят коротко: «Картинка про переезд офиса». Про письмо, дату и то, как картинка должна выглядеть, модель при этом ничего не знает.',
    lead2: 'Три кнопки ниже взяты из списка выше. Каждая дописывает к запросу одну фразу, а третья ещё прикладывает картинку-образец. Сейчас все выключены, поэтому вы видите ответ на тот самый короткий запрос. Включайте в любом сочетании: всего их восемь, и каждое я отправил модели по-настоящему.',
    addGroup: 'Что добавить к задаче',
    prompt: 'Запрос к модели',
    sampleAlt: 'Образец: плоская геометрическая настольная лампа в синем, жёлтом, красном и чёрном.',
    sampleCaption: 'Приложенный образец',
    result: 'Что она нарисовала',
    seen: 'Что здесь видно',
    note: 'Картинки сгенерированы заранее: Higgsfield, модель gpt_image_2_6, 06.11.2026. Каждую я получил с одного запуска, без отбора, образец тоже. Новый запуск даст другую картинку.',
  },
  en: {
    aria: 'How the brief changes the result',
    title: 'Build the brief yourself',
    lead1: 'Imagine your office is moving. You are writing an email to staff and want an image in it. People usually ask briefly: “An image about an office move.” The model then knows nothing about the email, the date, or how the image should look.',
    lead2: 'The three buttons below come from the list above. Each one adds a phrase to the prompt, and the third also attaches a sample image. They are all off now, so you see the answer to that short prompt. Turn them on in any combination: there are eight, and I really sent each one to the model.',
    addGroup: 'What to add to the task',
    prompt: 'Prompt to the model',
    sampleAlt: 'Sample: a flat geometric desk lamp in blue, yellow, red, and black.',
    sampleCaption: 'Attached sample',
    result: 'What it drew',
    seen: 'What you can see here',
    note: 'The images were generated in advance: Higgsfield, model gpt_image_2_6, November 6, 2026. Each came from a single run with no selection, the sample too. A new run will give a different image. They were generated from the Russian versions of these prompts, so any lettering in them is in Russian.',
  },
}[lang];

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="fig" id="fig-brief" aria-label={T.aria} data-base={base}>
<h3>{T.title}</h3>
<p class="lead">{T.lead1}</p>
<p class="lead">{T.lead2}</p>
<div class="row" role="group" aria-label={T.addGroup}>
{BRIEF_PARTS.map((part) => <button class="btn" type="button" aria-pressed="false" data-part={part.id}>{part.label}</button>)}
</div>
<div class="brief">
  <div class="brief-text">
    <p class="brief-label">{T.prompt}</p>
    <p class="brief-prompt"><span>{BRIEF_BASE}</span>{BRIEF_PARTS.map((part) => <span hidden data-text={part.id}> <mark>{part.text}</mark></span>)}</p>
    <figure class="brief-sample" id="brief-sample" hidden>
      <img src={`${base}brief/sample.webp`} alt={T.sampleAlt} width="300" height="202" loading="lazy">
      <figcaption>{T.sampleCaption}</figcaption>
    </figure>
  </div>
  <div class="brief-text">
    <p class="brief-label">{T.result}</p>
    <img class="brief-result" id="brief-result" src={`${base}${briefFile(0)}`} alt={BRIEF_RESULTS[0].alt} width="760" height="511" loading="lazy">
  </div>
</div>
<p class="brief-label">{T.seen}</p>
<p class="msg" id="brief-msg" aria-live="polite">{BRIEF_RESULTS[0].note}</p>
<p class="note">{T.note}</p>
</section>
