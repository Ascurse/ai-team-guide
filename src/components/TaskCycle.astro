---
import * as ruCycle from '../data/cycle.js';
import * as enCycle from '../data/en/cycle.js';

const { lang } = Astro.props;
const { CYCLE_FRAMES, CYCLE_NODES, VERDICT_NO, VERDICT_YES } = lang === 'en' ? enCycle : ruCycle;
const T = {
  ru: {
    title: 'Цикл задачи: где он идёт назад',
    aria: 'Цикл задачи',
    lead: 'Работа идёт по прямой, только пока проверка не скажет «нет». Тогда она возвращается через отладку к исполнению.',
    no: ': нет',
    yes: ': да',
  },
  en: {
    title: 'The task cycle: where it goes back',
    aria: 'Task cycle',
    lead: 'Work goes in a straight line only until a check says “no”. Then it goes back through debugging to execution.',
    no: ': no',
    yes: ': yes',
  },
}[lang];

const nameOf = (id) => CYCLE_NODES.find((node) => node.id === id).name;
const VERDICT_LABEL = { [VERDICT_NO]: T.no, [VERDICT_YES]: T.yes };
---
<section class="fig" id="fig-cycle" aria-label={T.aria}>
<h3>{T.title}</h3>
<p class="lead">{T.lead}</p>
<div class="cycle-run" id="cy-run" hidden aria-hidden="true" style={`--frames:${CYCLE_FRAMES.length}`}>
<div class="cycle-pin">
<div class="cycle-map" id="cy-map">
<svg id="cy-lines"></svg>
{CYCLE_NODES.map((node) => <div class="cycle-node" data-node={node.id}>{node.name}</div>)}
<i class="cycle-dot" id="cy-dot"></i>
</div>
<div class="cycle-text">
<div class="cycle-count" id="cy-count"></div>
<p id="cy-text"></p>
</div>
</div>
</div>
<ol class="cycle-steps" id="cy-steps">
{CYCLE_FRAMES.map((frame) => <li><strong>{nameOf(frame.node)}{VERDICT_LABEL[frame.verdict]}.</strong> {frame.text}</li>)}
</ol>
</section>
