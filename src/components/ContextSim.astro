---
import { dataNote } from '../data/freshness.js';

const { lang } = Astro.props;
const T = {
  ru: {
    aria: 'Симулятор сессии',
    title: 'Симулятор: что происходит с контекстом и кэшем',
    lead: 'Модель ничего не помнит между ходами. На каждом ходу она заново получает всю переписку, поэтому сессия становится тяжелее и дороже. Двигайте ползунок и жмите кнопки.',
    note: 'Высота столбика показывает цену хода. Красные столбики: ходы без кэша, где всё прочитано по полной цене. Учебная модель: 6K токенов на ход, 1.5K на ответ, кэшированный вход в 10 раз дешевле. Вход длиннее 272K стоит вдвое дороже, поэтому кривая ломается к концу. Цены из таблицы в разделе «Модели в разработке». Настоящая сессия будет отличаться, важна форма кривой.',
    stackAria: 'Заполнение контекста',
    mcp: 'Подключить MCP посреди сессии',
    compact: 'Сделать /compact',
    reset: 'Сбросить',
    turnCost: 'Цена этого хода',
    totalCost: 'Цена всей сессии',
    context: 'Контекст',
    turn: 'Ход',
    of50: 'из 50',
    model: 'Модель',
  },
  en: {
    aria: 'Session simulator',
    title: 'Simulator: what happens to the context and cache',
    lead: 'The model remembers nothing between turns. On each turn it receives the whole conversation again, so the session gets heavier and more expensive. Move the slider and press the buttons.',
    note: 'Bar height shows the cost of a turn. Red bars are turns without cache, where everything was read at full price. A teaching model: 6K tokens per turn, 1.5K per answer, cached input 10 times cheaper. Input over 272K costs twice as much, which is why the curve breaks near the end. Prices come from the table in “Models for development”. A real session will differ; the shape of the curve is what matters.',
    stackAria: 'Context fill',
    mcp: 'Connect MCP mid-session',
    compact: 'Run /compact',
    reset: 'Reset',
    turnCost: 'Cost of this turn',
    totalCost: 'Cost of the whole session',
    context: 'Context',
    turn: 'Turn',
    of50: 'of 50',
    model: 'Model',
  },
}[lang];
---
<section class="fig" id="fig-context" aria-label={T.aria}>
<h3>{T.title}</h3>
<p class="lead">{T.lead}</p>
<div class="row">
<label for="s-turn" style="flex:1 1 220px">{T.turn} <strong id="s-n">1</strong> {T.of50}
<input id="s-turn" type="range" min="1" max="50" value="1"></label>
<label for="s-model">{T.model}<br><select id="s-model"></select></label>
</div>
<div class="row">
<button class="btn" id="s-mcp" type="button">{T.mcp}</button>
<button class="btn" id="s-compact" type="button">{T.compact}</button>
<button class="btn" id="s-reset" type="button">{T.reset}</button>
</div>
<div class="stack" id="s-stack" role="img" aria-label={T.stackAria}></div>
<div class="scale" id="s-scale"></div>
<div class="legend" id="s-legend"></div>
<div class="stats">
<div class="stat"><div>{T.context}</div><strong id="s-ctx"></strong></div>
<div class="stat"><div>{T.turnCost}</div><strong id="s-cost"></strong></div>
<div class="stat"><div>{T.totalCost}</div><strong id="s-total"></strong></div>
</div>
<div id="s-msg" aria-live="polite"></div>
<div class="spark" id="s-spark" aria-hidden="true"></div>
<p class="note">{T.note}</p>
<p class="data-note">{dataNote(lang)}</p>
</section>
