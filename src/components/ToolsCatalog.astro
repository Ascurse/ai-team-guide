---
import * as ruTools from '../data/tools.js';
import * as enTools from '../data/en/tools.js';

const { lang } = Astro.props;
const { ALL_CATEGORIES_FILTER, ALL_TOOLS_FILTER, TOOL_CATEGORIES, TOOL_FILTERS, TOOLS } = lang === 'en' ? enTools : ruTools;
const T = {
  ru: {
    aria: 'Каталог инструментов',
    title: 'Двадцать один инструмент по четырём категориям',
    lead: 'Порядок внутри разделов ничего не значит, это не рейтинг. Фильтруйте каталог по назначению инструмента и по тому, где он работает.',
    categoryGroup: 'Категория инструмента',
    whereGroup: 'Где работает инструмент',
    whereTags: 'Где работает',
    purpose: 'Зачем нужен.',
    feature: 'В чём фишка.',
    pros: 'Сильные стороны',
    cons: 'Оговорки',
    when: 'Когда брать.',
    site: 'Сайт',
    note: 'Сведения собраны 7 ноября 2026 из документации, журналов выпусков и репозиториев самих продуктов. На одинаковых задачах я их не сравнивал, поэтому «когда брать» это мнение, а не результат теста. «Не подтверждено» значит, что этого нет в изученных материалах, а не что функции нет. Логотипы принадлежат их владельцам.',
    allCategories: 'Все категории',
    allFormats: 'Все форматы',
    docs: 'Документация',
  },
  en: {
    aria: 'Tool catalog',
    title: 'Twenty-one tools in four categories',
    lead: 'The order within sections means nothing; this is not a ranking. Filter the catalog by what a tool is for and where it runs.',
    categoryGroup: 'Tool category',
    whereGroup: 'Where the tool runs',
    whereTags: 'Where it runs',
    purpose: 'What it is for.',
    feature: 'What stands out.',
    pros: 'Strengths',
    cons: 'Caveats',
    when: 'When to use it.',
    site: 'Website',
    note: 'Collected on November 7, 2026 from the products’ own documentation, changelogs, and repositories. I did not compare them on identical tasks, so “when to use it” is an opinion, not a test result. “Not confirmed” means it is not in the materials I studied, not that the feature does not exist. Logos belong to their owners.',
    allCategories: 'All categories',
    allFormats: 'All formats',
    docs: 'Documentation',
  },
}[lang];

const CATEGORY_FILTERS = [{ id: ALL_CATEGORIES_FILTER, label: T.allCategories }, ...TOOL_CATEGORIES];
const FILTERS = [{ id: ALL_TOOLS_FILTER, label: T.allFormats }, ...TOOL_FILTERS];
const TAG_LABELS = Object.fromEntries(TOOL_FILTERS.map((filter) => [filter.id, filter.label]));
const GROUPS = TOOL_CATEGORIES.map((category) => ({
  ...category,
  tools: TOOLS.filter((tool) => tool.category === category.id),
}));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="fig" id="fig-tools" aria-label={T.aria}>
<h3>{T.title}</h3>
<p class="lead">{T.lead}</p>
<div class="tool-filters js-only">
  <div class="row" role="group" aria-label={T.categoryGroup}>
    {CATEGORY_FILTERS.map((category) => (
      <button
        class="btn"
        type="button"
        aria-pressed={String(category.id === ALL_CATEGORIES_FILTER)}
        data-tool-category={category.id}
      >{category.label}</button>
    ))}
  </div>
  <div class="row" role="group" aria-label={T.whereGroup}>
    {FILTERS.map((filter) => (
      <button
        class="btn"
        type="button"
        aria-pressed={String(filter.id === ALL_TOOLS_FILTER)}
        data-tool-filter={filter.id}
      >{filter.label}</button>
    ))}
  </div>
</div>
<p class="tools-count js-only" role="status" data-tools-count></p>
{GROUPS.map((group) => (
  <div class="tool-group" data-tool-group={group.id}>
    <div class="tool-group-head">
      <h4 class="tool-group-title">{group.label}</h4>
      <span class="tool-group-count" data-group-count={group.id}>{group.tools.length}</span>
    </div>
    <p class="tool-group-desc">{group.description}</p>
    <ul class="tools">
      {group.tools.map((tool) => (
        <li class="tool" data-tool-tags={tool.tags.join(' ')} data-tool-cat={tool.category}>
          <div class="tool-head">
            <span class:list={['tool-logo', { 'tool-logo-full': tool.fullLogo }]}>
              <img src={`${base}/logos/${tool.logo}`} alt="" width="40" height="40" loading="lazy" />
            </span>
            <div>
              <h5 class="tool-name">{tool.name}</h5>
              <p class="tool-vendor">{tool.vendor}</p>
            </div>
          </div>
          <p class="tool-summary">{tool.summary}</p>
          <ul class="tool-tags" aria-label={T.whereTags}>{tool.tags.map((tag) => <li>{TAG_LABELS[tag]}</li>)}</ul>
          <p class="tool-fact"><strong>{T.purpose}</strong> {tool.purpose}</p>
          <p class="tool-fact"><strong>{T.feature}</strong> {tool.feature}</p>
          <p class="tool-label">{T.pros}</p>
          <ul class="tool-list tool-pros">{tool.pros.map((item) => <li>{item}</li>)}</ul>
          <p class="tool-label">{T.cons}</p>
          <ul class="tool-list tool-cons">{tool.cons.map((item) => <li>{item}</li>)}</ul>
          <p class="tool-when"><strong>{T.when}</strong> {tool.when}</p>
          <p class="tool-links">
            <a href={tool.url} target="_blank" rel="noopener noreferrer">{T.site}</a>
            <a href={tool.docs} target="_blank" rel="noopener noreferrer">{tool.docsLabel ?? T.docs}</a>
          </p>
        </li>
      ))}
    </ul>
  </div>
))}
<p class="note">{T.note}</p>
</section>
