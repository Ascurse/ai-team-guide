---
import { dataNote } from '../data/freshness.js';
import { PRICES, compactCurve, money } from '../lib/sim.js';
import { STRINGS } from '../scripts/strings.js';

const { lang } = Astro.props;
const T = {
  ru: {
    aria: 'Когда окупается компакт',
    title: 'Кривая сессии: когда окупается /compact',
    lead: 'Компакт стоит денег сразу, а экономит потом. На границе фазы он окупается, перед концом задачи только теряет деньги.',
    note: 'Учебная модель на цене Terra. На ходу компакта модель читает контекст из кэша и пишет выжимку в 15K токенов по цене выхода, потом первый ход идёт без кэша. Длина ограничена 40 ходами: дальше контекст уходит за 272K, вход там вдвое дороже, и компакт окупается быстрее. Деньги тут не единственный довод: качество кода падает после 40–60 шагов или 40K–70K токенов (один источник).',
    svgAria: 'Накопленная цена сессии с компактом и без',
    length: 'Длина задачи:',
    at: '/compact на ходу',
    phase: 'На границе фазы',
    late: 'За 2 хода до конца',
    plain: 'Без компакта',
    comp: 'С компактом',
    diff: 'Разница',
    turns: 'ходов',
  },
  en: {
    aria: 'When a compact pays off',
    title: 'The session curve: when /compact pays off',
    lead: 'A compact costs money now and saves it later. At a phase boundary it pays off; just before the end of a task it only loses money.',
    note: 'A teaching model at Terra prices. On the compact turn the model reads the context from cache and writes a 15K-token summary at the output price, then the first turn runs without cache. Length is capped at 40 turns: past that the context goes over 272K, input costs twice as much, and a compact pays off faster. Money is not the only argument: code quality drops after 40–60 steps or 40K–70K tokens (one source).',
    svgAria: 'Cumulative session cost with and without a compact',
    length: 'Task length:',
    at: '/compact on turn',
    phase: 'At a phase boundary',
    late: '2 turns before the end',
    plain: 'Without compact',
    comp: 'With compact',
    diff: 'Difference',
    turns: 'turns',
  },
}[lang];

const START = { length: 40, at: 30 };
const MAX_LENGTH = 40;
const start = compactCurve(START.length, START.at, PRICES['GPT-6.1 Terra']);
---
<section class="fig" id="fig-curve" aria-label={T.aria}>
<h3>{T.title}</h3>
<p class="lead">{T.lead}</p>
<div class="js-only">
<div class="row">
<label for="c-length" style="flex:1 1 200px">{T.length} <strong id="c-length-n">{START.length}</strong> {T.turns}
<input id="c-length" type="range" min="10" max={MAX_LENGTH} value={START.length}></label>
<label for="c-at" style="flex:1 1 200px">{T.at} <strong id="c-at-n">{START.at}</strong>
<input id="c-at" type="range" min="5" max={START.length - 1} value={START.at}></label>
</div>
<div class="row">
<button class="btn" id="c-phase" type="button">{T.phase}</button>
<button class="btn" id="c-late" type="button">{T.late}</button>
</div>
<svg class="curve" id="c-svg" role="img" aria-label={T.svgAria}></svg>
<div class="legend"><span><b class="k-plain"></b>{T.plain}</span><span><b class="k-comp"></b>{T.comp}</span></div>
</div>
<div class="stats">
<div class="stat"><div>{T.plain}</div><strong id="c-plain">{money(start.plain.at(-1))}</strong></div>
<div class="stat"><div>{T.comp}</div><strong id="c-comp">{money(start.compacted.at(-1))}</strong></div>
<div class="stat"><div>{T.diff}</div><strong id="c-saved">{money(start.saved)}</strong></div>
</div>
<div class="msg" id="c-msg" aria-live="polite">{STRINGS[lang].curve.paidBack(start.steps)}</div>
<p class="note">{T.note}</p>
<p class="data-note">{dataNote(lang)}</p>
</section>
