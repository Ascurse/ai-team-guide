---
import * as guide from '../content/guide.md';
import BriefBuilder from '../components/BriefBuilder.astro';
import ContextSim from '../components/ContextSim.astro';
import DelegationTree from '../components/DelegationTree.astro';
import GuessDemo from '../components/GuessDemo.astro';
import ModelLadder from '../components/ModelLadder.astro';
import ModelPicker from '../components/ModelPicker.astro';
import PageToc from '../components/PageToc.astro';
import SessionCurve from '../components/SessionCurve.astro';
import SkillBuilder from '../components/SkillBuilder.astro';
import ToolsCatalog from '../components/ToolsCatalog.astro';
import SkillPack from '../components/SkillPack.astro';
import SpendMap from '../components/SpendMap.astro';
import TaskCycle from '../components/TaskCycle.astro';
import { DATA_NOTE } from '../data/freshness.js';
import { addDataNotes } from '../lib/data-notes.mjs';
import { buildPages, pageUrl } from '../lib/pages.mjs';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/guide.css';
import '../styles/workshop.css';
import '../styles/hero.css';
import '../styles/explainers.css';

export async function getStaticPaths() {
  const WIDGETS = [
    { Widget: BriefBuilder, before: /<h2[^>]*>Контекст<\/h2>/g },
    { Widget: ContextSim, before: /<h2[^>]*>Проверка<\/h2>/g },
    { Widget: GuessDemo, before: /<h2[^>]*>Если не получилось<\/h2>/g },
    { Widget: ModelLadder, before: /<h2[^>]*>Модели в разработке<\/h2>/g },
    { Widget: ModelPicker, before: /<p>Цены API за 1M токенов/g },
    { Widget: SkillBuilder, before: /<p>Где это делается/g },
    { Widget: TaskCycle, before: /<p><strong>Постановка\.<\/strong>/g },
    { Widget: DelegationTree, before: /<h3[^>]*>Как это устроено в Codex<\/h3>/g },
    { Widget: SpendMap, before: /<p>Что режет расход/g },
    { Widget: SessionCurve, before: /<p>Что не сработало или вредит/g },
    { Widget: ToolsCatalog, before: /<h2[^>]*>Мой стек/g },
    { Widget: SkillPack, before: /<h2[^>]*>Готовый набор/g },
  ];
  // Вики-ссылки vault снимаются здесь: guide.md побайтно совпадает с источником
  const html = addDataNotes((await guide.compiledContent()).replace(/\[\[([^\]]+)\]\]/g, '$1'), DATA_NOTE).replaceAll('<table>', '<div class="tw"><table>').replaceAll('</table>', '</table></div>');
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const pages = buildPages({ html, headings: guide.getHeadings(), base, widgets: WIDGETS });
  return pages.map((current) => ({ params: { page: current.slug || undefined }, props: { current, pages } }));
}

const REPO_URL = 'https://github.com/Ascurse/ai-team-guide';
const SITE_TITLE = 'Как работать с AI';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { current, pages } = Astro.props;
const [home] = pages;
const isHome = current === home;
const stripTags = (html) => html.replace(/<[^>]+>/g, '');
const plainTitle = stripTags(home.title);
const description = stripTags(home.summary);
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{isHome ? SITE_TITLE : `${current.nav} · ${SITE_TITLE}`}</title>
<meta name="description" content={description}>
<meta property="og:title" content={isHome ? plainTitle : `${current.nav} · ${SITE_TITLE}`}>
<meta property="og:description" content={description}>
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
</head>
<body>
<div class="progress" aria-hidden="true"><i id="progress"></i></div>

{isHome && (
<header class="hero">
  <div>
    <h1 class="top" id={home.anchor} set:html={home.title} />
    <p class="sum" set:html={home.summary} />
    <div class="doors">{pages.slice(1).map((page) => <a href={pageUrl(base, page.slug)}>{page.nav}</a>)}</div>
  </div>
  <p class="scene-fallback" id="scene-fallback">Как устроена сессия с моделью, показывает <a href={`${pageUrl(base, 'everyone')}#fig-context`}>симулятор контекста</a> на странице «Для всех».</p>
  <section class="scene" id="scene" aria-label="Стопка контекста" hidden>
    <h2>Каждый ход модель читает всё заново</h2>
    <div class="stage" id="stage" role="img" aria-label="Стопка контекста: растёт с каждым ходом, значения показаны ниже">
      <div class="key" aria-hidden="true">
        <div><b style="background:var(--color-ink)"></b>Инструкции</div>
        <div><b style="background:var(--signal-blue)"></b>Инструменты</div>
        <div><b style="background:var(--signal-yellow)"></b>История из кэша</div>
        <div><b style="background:var(--signal-red)"></b>По полной цене</div>
      </div>
    </div>
    <div class="cells">
      <div class="cell"><span>Контекст</span><strong id="h-ctx"></strong></div>
      <div class="cell"><span>Цена хода</span><strong id="h-cost"></strong></div>
      <div class="cell"><span>Вся сессия</span><strong id="h-total"></strong></div>
    </div>
    <p class="data-note">{DATA_NOTE}</p>
    <div id="h-msg" aria-live="polite"></div>
    <label for="h-turn">Ход <strong id="h-n">1</strong> из 50</label>
    <input id="h-turn" type="range" min="1" max="50" value="1">
    <div class="row">
      <button class="btn primary" id="h-next" type="button">Следующий ход</button>
      <button class="btn" id="h-play" type="button" aria-pressed="false">Автоход</button>
      <button class="btn" id="h-mcp" type="button">Подключить MCP</button>
      <button class="btn" id="h-compact" type="button">/compact</button>
      <button class="btn" id="h-reset" type="button">Сначала</button>
    </div>
  </section>
</header>
)}

<div class="layout">
<nav class="toc" aria-label="Содержание">
  <PageToc pages={pages} current={current} base={base} />
</nav>
<main>
  <div class="mobile-bar">
    <details class="mobile-toc"><summary>Содержание</summary><div class="toc-list">
      <PageToc pages={pages} current={current} base={base} />
    </div></details>
  </div>
  <article class="page">
    {current.parts.map(({ html, Widget }) => (<Fragment set:html={html} /><Widget />))}
    <Fragment set:html={current.tail} />
    <nav class="pager" aria-label="Соседние страницы">
      {current.prev && <a class="prev" rel="prev" href={pageUrl(base, current.prev.slug)}>← {current.prev.nav}</a>}
      {current.next && <a class="next" rel="next" href={pageUrl(base, current.next.slug)}>{current.next.nav} →</a>}
    </nav>
  </article>
</main>
</div>

<footer class="site"><a href={REPO_URL}>Исходники на GitHub</a></footer>
<script src="../scripts/main.js"></script>
</body>
</html>
